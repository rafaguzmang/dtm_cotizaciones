<odoo>
    <record id="module_category_ventas_admin" model = "ir.module.category">
        <field name="name">Ventas</field>
        <field name="description">Da permisos de administrador de ventas</field>
        <field name="sequence">51</field>
    </record>

    <record id="group_ventas_admin" model="res.groups">
        <field name="name">Administración</field>
        <field name="category_id" ref="module_category_ventas_admin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_ventas_usuarios" model="res.groups">
        <field name="name">Usuarios Ventas</field>
        <field name="category_id" ref="module_category_ventas_admin"/>
    </record>

    <record id="group_ventas_restriccion" model="res.groups">
        <field name="name">Restricción</field>
        <field name="category_id" ref="module_category_ventas_admin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
